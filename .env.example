# Environment variables read by the Hydro Twin backend.
#
# The backend reads plain environment variables from the shell; it does NOT
# load .env files automatically. Use this file as a naming template only.

# Absolute path to a local DualSPHysics installation.
# Required for POST /api/simulations/sph (the solver binaries are invoked
# from <DUALSPHYSICS_ROOT>/bin/windows/...).
# Example: DUALSPHYSICS_ROOT=C:\DualSPHysics_v5.4
DUALSPHYSICS_ROOT=
