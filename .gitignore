# ========================= Node / frontend =========================
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# ========================= Python =========================
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/

# ========================= Environment / secrets =========================
