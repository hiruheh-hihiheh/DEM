# ========================= Node / frontend =========================
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# ========================= Python =========================
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/

# ========================= Environment / secrets =========================
# Never commit local environment files (add real values only in your shell).
.env
.env.*
!.env.example

# ========================= IDEs & OS =========================
.vscode/
.idea/
*.sw?
.DS_Store
Thumbs.db

# ========================= Logs =========================
*.log
logs/

# ========================= Simulation outputs (DualSPHysics) =========================
# Per-run solver artifacts. Regenerate via POST /api/simulations/sph.
simulations/runs/
# Scenario XML is rewritten by the backend before every run.
simulations/templates/*.xml

# ========================= Example case outputs =========================
# Regenerated by examples/main/HADR_TerrainChouldari scripts
# (generate_terrain_case.py and run_standalone_case.bat).
examples/**/*_out/
examples/**/terrain/
examples/**/*_Def.xml
examples/**/*_gate_motion.txt
examples/**/terrain_case_summary.json
examples/**/chouldari_sph_terrain.stl
examples/**/*_geometry_preview*

# ========================= Generated GIS data =========================
# Only the small sample inputs needed by the pipeline/examples are tracked.
# Everything else under data/terrain is produced by the terrain modules
# (clip / condition / flow / domain / sph_terrain / mesh / preview).
data/terrain/*
!data/terrain/chouldari/
data/terrain/chouldari/*
!data/terrain/chouldari/chouldari_5km.tif
!data/terrain/chouldari/chouldari_sph_terrain.npz
!data/terrain/chouldari/chouldari_sph_terrain.stl
