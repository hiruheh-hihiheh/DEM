.env
.env.*
!.env.example

# ========================= IDEs & OS =========================
.vscode/
.idea/
*.sw?
.DS_Store
Thumbs.db

# ========================= Logs =========================
*.log
logs/

# ========================= Simulation outputs (DualSPHysics) =========================
# Runtime data only: per-run solver artifacts (POST /api/simulations/sph and
# scripts/run_scenario.py), generated scenario XML, run logs and metadata.
# simulations/templates/ is re-created by the backend when needed.
simulations/

# ========================= Example case outputs =========================
# Regenerated by examples/main/HADR_TerrainChouldari scripts
# (generate_terrain_case.py and run_standalone_case.bat).
examples/**/*_out/
examples/**/terrain/
examples/**/*_Def.xml
examples/**/*_gate_motion.txt
examples/**/terrain_case_summary.json
examples/**/chouldari_sph_terrain.stl
examples/**/*_geometry_preview*

# ========================= Scenario runner =========================
# Machine-local configuration (e.g. DualSPHysics install path).
# Copy scenarios/local.example.json and edit locally.
scenarios/local.json

# ========================= Generated GIS data =========================
# Only the small sample inputs needed by the pipeline/examples are tracked.
# Everything else under data/terrain is produced by the terrain modules
# (clip / condition / flow / domain / sph_terrain / mesh / preview) or by
# scripts/run_scenario.py (processed/ and metadata/ are fully generated).
#
# Layout per scenario site:
#   data/terrain/<site>/input/      raw DEM inputs (only samples listed below)
#   data/terrain/<site>/processed/  conditioned/flow/domain rasters + previews
#   data/terrain/<site>/sph/        NPZ/CSV/STL terrain products + previews
#   data/terrain/<site>/metadata/   scenario manifest (runtime)
data/terrain/*
!data/terrain/*/
data/terrain/*/*
!data/terrain/*/input/
data/terrain/*/input/*
!data/terrain/*/input/chouldari_5km.tif
!data/terrain/*/sph/
data/terrain/*/sph/*
!data/terrain/*/sph/chouldari_sph_terrain.npz
!data/terrain/*/sph/chouldari_sph_terrain.stl
