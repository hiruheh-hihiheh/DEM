# Frontend environment configuration (copy to `.env.local` to override).
# All values are optional — the defaults work for local development and no
# API keys are required or committed anywhere.

# Backend base URL used by the app (must include the `/api` suffix).
#VITE_API_BASE=http://127.0.0.1:8000/api

# Satellite basemap raster tile URL template.
# Default (keyless): Esri World Imagery. Must contain {z}/{y}/{x} (or
# {z}/{x}/{y}) placeholders. Point this at your own provider if required.
#VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Attribution string shown in the map corner for the satellite provider.
#VITE_SATELLITE_ATTRIBUTION=Esri, Maxar, Earthstar Geographics
